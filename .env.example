# Smart Parking Management System - Environment Configuration

# Flask Secret Key for Sessions and CSRF protection
SECRET_KEY=super-secret-smart-parking-key-change-in-production-2026

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Database Configuration (MySQL)
# Default MySQL configuration for local XAMPP, WAMP, or MySQL Server installation
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_parking_db

# Application Timezone
TIMEZONE=Asia/Kolkata
